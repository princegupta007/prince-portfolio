{
  "name": "prince-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "agent:content-scan": "tsx agent/tools/content-scan.ts",
    "agent:screenshot-grid": "tsx agent/tools/screenshot-grid.ts",
    "agent:link-check": "tsx agent/tools/link-check.ts",
    "agent:bundle-check": "tsx agent/tools/bundle-check.ts",
    "agent:secret-scan": "echo \"[agent] secret-scan lands in Phase 10\" && exit 0",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/run.ts",
    "agent:smoke": "tsx agent/tools/smoke-prod.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.34.5"
}
